{
  "name": "phaser-game-v1",
  "description": "Phaser 4 + TypeScript game.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "tsc --noEmit && vite build --config vite/config.prod.mjs",
    "preview": "vite preview --config vite/config.prod.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "phaser": "4.0.0",
    "terser": "^5.39.0",
    "zod": "^3.24.1"
  }
}
